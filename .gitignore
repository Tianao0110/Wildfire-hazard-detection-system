# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual env
.venv/
venv/
env/

# Project data (large / generated)
models/*.pt
outputs/
config/settings.json

# The macOS icon is built from branding/logo.png on every install, and at 1024px
# with full-bleed artwork it is ~600 KB - not something to carry in history when
# nothing ever reads it from git. assets/wildfire.ico stays tracked only because
# it already is: removing it now would not reclaim the history it sits in, and
# at 53 KB it is not worth a churn commit. Both are regenerated by
# scripts/install_desktop_app.py, so a fresh clone needs neither.
assets/wildfire.icns

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.gstack/

# ML runtime logs / checkpoints (auto-generated by DeepForest / Lightning)
lightning_logs/
catboost_info/
*.ckpt
*.pt

# Drone image data (kept local, not committed)
sample_data/*.JPG
sample_data/*.jpg
sample_data/*.tif
sample_data/*.tiff
sample_data/*.png

# Offline map data (downloaded per operating area)
map/

# Local dev tooling
.claude/

# branding/logo.png is tracked on purpose - the project ships with its own mark,
# so a fresh clone looks right without anyone hunting for an asset. A deployment
# that drops in a different logo will show it as a modified file, which is the
# honest signal that the build is rebranded.
config/window_state.json
