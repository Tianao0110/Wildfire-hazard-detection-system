# Copy to .env.local (gitignored) and fill in. Restart `npx expo start` after
# any change - Expo reads these at bundle time, not at runtime.
#
# The CONTAINER url plus its SAS token. Read + List is enough to view runs;
# add Create + Write if you also want field-note sync-back to work.
# Never use the storage account key here.
EXPO_PUBLIC_WILDFIRE_SAS_URL=https://<account>.blob.core.windows.net/wildfire-runs?sv=...&sig=...
